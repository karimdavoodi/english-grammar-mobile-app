# Release signing template — copy this file to `android/keystore.properties`
# and fill in the values for your OWN keystore. `keystore.properties` is
# gitignored and MUST NEVER be committed. See docs/release.md for the full
# walkthrough (generate a keystore with keytool, create the file, build).
#
# `storeFile` is resolved relative to the `android/app` module directory, so a
# keystore kept at `android/app/english-grammar-game-release.keystore` is
# referenced by just its file name; a keystore elsewhere uses a path relative to
# android/app (e.g. ../release.keystore for one at the repo root).
storeFile=english-grammar-game-release.keystore
storePassword=CHANGE_ME
keyAlias=englishgrammargame
keyPassword=CHANGE_ME
